APP_ORIGIN=http://localhost:3000

# Public institution identity. One deployment/database belongs to one university.
# Names are displayed as plain text; language-specific values override the shared name.
# ORGANIZATION_NAME=Example University
# ORGANIZATION_NAME_RU=Пример университета
# ORGANIZATION_NAME_KK=Университет атауы
# ORGANIZATION_INITIALS=EU

# Recommended for hosted deployments: a dedicated server-only configuration
# avoids collisions with provider-managed Supabase aliases. Set all three.
UNIVOICE_SUPABASE_URL=
UNIVOICE_SUPABASE_PUBLISHABLE_KEY=
UNIVOICE_SUPABASE_SECRET_KEY=

# Legacy alternative, used only when all UNIVOICE_SUPABASE_* values are empty.
# Create a project and apply supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=
# Legacy fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.

# Optional AI: explicit report consent and local redaction are always required.
# Choose groq (default), cloudflare, openai, or disabled.
# Use a provider's Free plan to stay within its free quota; keys are server-only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only Groq HTTP 429 triggers one reserve attempt. Empty disables the reserve.
# No fallback on privacy, auth, network or malformed-response failures.
AI_FALLBACK_PROVIDER=cloudflare

# Alternative free provider. Both account ID and API token are required.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Optional paid provider, used ONLY when AI_PROVIDER=openai.
# Groq/Cloudflare never call OpenAI or generate embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Production: set a random 32+ byte secret and a header that your ingress ALWAYS
# overwrites. On Vercel use x-vercel-forwarded-for; never trust arbitrary client headers.
RATE_LIMIT_SALT=
# TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Optional error diagnostics. Browser and request errors require cookie consent.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=univoice
# Optional build-only token for private source-map upload. Never NEXT_PUBLIC_.
# SENTRY_AUTH_TOKEN=
