APP_ORIGIN=http://localhost:3000

# Public institution identity. One deployment/database belongs to one university.
# Names are displayed as plain text; language-specific values override the shared name.
# ORGANIZATION_NAME=Example University
# ORGANIZATION_NAME_RU=Пример университета
# ORGANIZATION_NAME_KK=Университет атауы
# ORGANIZATION_INITIALS=EU

# Required. Create a project and apply supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=
# Legacy fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.

# Optional live AI, used only after separate report consent and local redaction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Production: set a random 32+ byte secret and a header that your ingress ALWAYS
# overwrites. On Vercel use x-vercel-forwarded-for; never trust arbitrary client headers.
RATE_LIMIT_SALT=
# TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Optional error diagnostics. Browser and request errors require cookie consent.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=univoice
# Optional build-only token for private source-map upload. Never NEXT_PUBLIC_.
# SENTRY_AUTH_TOKEN=
